# Copy to .env and fill in. .env is gitignored.

# LLM used for planning, scoring, and summarizing (LangChain "provider:model" string)
CHAT_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=

# Embeddings for novelty / near-duplicate detection (Anthropic has no embeddings API)
EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=

# Web search for sources without a usable RSS feed
TAVILY_API_KEY=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=daily-tech-upgrade-agent
